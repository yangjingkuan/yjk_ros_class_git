<launch>
    <!-- 启动C++发布者节点：ros_publisher_node -->
    <node name="ros_publisher_node" pkg="my_class_pkg" type="ros_publisher_node" output="screen" />
    <!-- 启动C++订阅者节点：ros_subscriber_node -->
    <node name="ros_subscriber_node" pkg="my_class_pkg" type="ros_subscriber_node" output="screen" />
</launch>
